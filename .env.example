# AisleGuard Vision - example environment file.
#
#   cp .env.example .env      # then edit .env (it is git-ignored)
#
# NOTHING in this file is a real credential. Never commit a populated .env.
# Camera URLs in config/cameras.yaml are written as ${VAR} placeholders and are
# resolved from the process environment at load time, so RTSP passwords never
# live in the repository. All camera URLs are sanitized before logging
# (see src/aisleguardvision/utils/sanitize.py).

# ---------------------------------------------------------------------------
# Cameras
# ---------------------------------------------------------------------------
# Full RTSP URLs including credentials, one per configured camera id.
# Format: rtsp://<user>:<password>@<host>:<port>/<path>
CAM_001_RTSP=rtsp://viewer:CHANGE_ME@192.0.2.10:554/Streaming/Channels/101
CAM_002_RTSP=rtsp://viewer:CHANGE_ME@192.0.2.11:554/Streaming/Channels/101
CAM_003_RTSP=rtsp://viewer:CHANGE_ME@192.0.2.12:554/Streaming/Channels/101

# ---------------------------------------------------------------------------
# Alert delivery
# ---------------------------------------------------------------------------
# Webhook endpoint that receives SecurityEvent payloads. Leave empty to disable.
AISLEGUARD_WEBHOOK_URL=
# Bearer token sent as `Authorization: Bearer <token>`. Never logged.
AISLEGUARD_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# API service
# ---------------------------------------------------------------------------
AISLEGUARD_API_HOST=127.0.0.1
AISLEGUARD_API_PORT=8000
# Shared secret required in the `X-API-Key` header. Empty disables auth
# (acceptable only on a trusted loopback interface).
AISLEGUARD_API_KEY=

# ---------------------------------------------------------------------------
# Runtime overrides (optional - these override config/app.yaml)
# ---------------------------------------------------------------------------
# AISLEGUARD_LOG_LEVEL=INFO
# AISLEGUARD_LOG_FORMAT=text          # text | json
# AISLEGUARD_DEVICE=auto              # auto | cuda | cuda:0 | mps | cpu
# AISLEGUARD_CONFIG_DIR=config
# AISLEGUARD_INCIDENT_DIR=data/incidents

# FFmpeg transport options for RTSP. TCP is far more robust than UDP for
# H.264/H.265 over congested store networks.
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp|stimeout;5000000
